{
  "name": "@paralock/evm",
  "version": "0.1.0",
  "description": "Paralock escrow clients for EVM chains (Tempo, Base, Ethereum): the hash-time-locked ParalockHTLC and the adaptor-signature ParalockAdaptorEscrow, built on viem.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "generate:abi": "forge build --root ../../contracts && node scripts/generate-abi.ts"
  },
  "dependencies": {
    "viem": "^2.57.4"
  },
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "keywords": [
    "evm",
    "tempo",
    "htlc",
    "escrow",
    "atomic-swap",
    "viem",
    "adaptor-signatures"
  ],
  "author": "bitfalt (https://github.com/bitfalt)",
  "homepage": "https://github.com/bitfalt/Paralock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfalt/Paralock.git",
    "directory": "packages/evm"
  },
  "bugs": {
    "url": "https://github.com/bitfalt/Paralock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
