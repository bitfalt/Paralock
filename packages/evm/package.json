{
  "name": "@paralock/evm",
  "version": "0.3.1",
  "description": "viem clients for the Paralock escrows on EVM chains (Tempo, Base, Ethereum, Arbitrum, Robinhood Chain, HyperEVM): the hash-time-locked ParalockHTLC and the signature-release ParalockAdaptorEscrow, plus a verified network registry.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "generate:abi": "forge build --root ../../contracts && node scripts/generate-abi.ts"
  },
  "dependencies": {
    "viem": "^2.57.4"
  },
  "files": [
    "README.md",
    "artifacts",
    "dist",
    "src"
  ],
  "keywords": [
    "evm",
    "htlc",
    "escrow",
    "atomic-swap",
    "adaptor-signatures",
    "viem",
    "tempo",
    "stablecoin",
    "usdc"
  ],
  "author": "bitfalt (https://github.com/bitfalt)",
  "homepage": "https://github.com/bitfalt/Paralock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfalt/Paralock.git",
    "directory": "packages/evm"
  },
  "bugs": {
    "url": "https://github.com/bitfalt/Paralock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
