{
  "name": "@paralock/adaptor",
  "version": "0.1.2",
  "description": "ECDSA adaptor signatures on secp256k1 with DLEQ proofs (pre-sign, pre-verify, adapt, extract) for scriptless atomic swaps. Pure TypeScript on @noble/curves, browser-safe.",
  "keywords": [
    "adaptor-signatures",
    "ecdsa",
    "secp256k1",
    "scriptless-scripts",
    "atomic-swap",
    "dleq",
    "cryptography"
  ],
  "license": "MIT",
  "author": "bitfalt (https://github.com/bitfalt)",
  "homepage": "https://github.com/bitfalt/Paralock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfalt/Paralock.git",
    "directory": "packages/adaptor"
  },
  "bugs": {
    "url": "https://github.com/bitfalt/Paralock/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  }
}
