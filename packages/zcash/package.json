{
  "name": "@paralock/zcash",
  "version": "0.3.1",
  "description": "Zcash transparent HTLCs and 2-of-2 multisig locks in pure TypeScript: v5 transactions, ZIP 244 signature hashes (checked against the official vectors), ZIP 317 fees, and a Zebra JSON-RPC client. Browser-safe.",
  "keywords": [
    "zcash",
    "htlc",
    "multisig",
    "atomic-swap",
    "zip-244",
    "zip-317",
    "transaction-builder",
    "zebra",
    "typescript"
  ],
  "license": "MIT",
  "author": "bitfalt (https://github.com/bitfalt)",
  "homepage": "https://github.com/bitfalt/paralock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfalt/paralock.git",
    "directory": "packages/zcash"
  },
  "bugs": {
    "url": "https://github.com/bitfalt/paralock/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@paralock/adaptor": "workspace:*"
  }
}
