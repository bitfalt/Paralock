{
  "name": "@paralock/zcash",
  "version": "0.1.0",
  "description": "Zcash transparent HTLCs in pure TypeScript: v5 transactions, ZIP-244 sighash, claim/refund for atomic swaps.",
  "keywords": [
    "zcash",
    "htlc",
    "atomic-swap",
    "zip-244",
    "transparent",
    "bitcoin-script",
    "typescript"
  ],
  "license": "MIT",
  "author": "bitfalt (https://github.com/bitfalt)",
  "homepage": "https://github.com/bitfalt/Paralock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfalt/Paralock.git",
    "directory": "packages/zcash"
  },
  "bugs": {
    "url": "https://github.com/bitfalt/Paralock/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@paralock/adaptor": "workspace:*"
  }
}
