{
  "name": "@paralock/sdk",
  "version": "0.1.0",
  "description": "Paralock swap SDK: trustless atomic swaps between Zcash and EVM chains (Tempo first).",
  "keywords": [
    "zcash",
    "atomic-swap",
    "cross-chain",
    "evm",
    "tempo",
    "privacy",
    "market-maker"
  ],
  "license": "MIT",
  "author": "Daniel Garbanzo",
  "homepage": "https://github.com/bitfalt/Paralock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfalt/Paralock.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/bitfalt/Paralock/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@paralock/adaptor": "workspace:*",
    "@paralock/evm": "workspace:*",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0"
  },
  "devDependencies": {
    "@paralock/zcash": "workspace:*"
  }
}
