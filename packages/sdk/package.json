{
  "name": "@paralock/sdk",
  "version": "0.3.2",
  "description": "Maker and taker engines for trustless atomic swaps and payments between Zcash and stablecoins on EVM chains: factories, crash-safe persistence and recovery, quote validation, maker risk limits, and an HTTP transport.",
  "keywords": [
    "zcash",
    "atomic-swap",
    "cross-chain",
    "htlc",
    "adaptor-signatures",
    "stablecoin",
    "payments",
    "market-maker",
    "evm",
    "tempo"
  ],
  "license": "MIT",
  "author": "bitfalt (https://github.com/bitfalt)",
  "homepage": "https://github.com/bitfalt/paralock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfalt/paralock.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/bitfalt/paralock/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@paralock/adaptor": "workspace:*",
    "@paralock/evm": "workspace:*",
    "@paralock/zcash": "workspace:*",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "viem": "^2.57.4"
  }
}
