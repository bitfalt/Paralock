    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@paralock/adaptor": "workspace:*",
    "@paralock/evm": "workspace:*",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0"
  },
  "devDependencies": {
    "@paralock/zcash": "workspace:*"
  }
