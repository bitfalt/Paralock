{
  "name": "@paralock/sdk",
  "version": "0.1.0",
  "description": "Paralock swap SDK: trustless atomic swaps between Zcash and EVM chains (Tempo first).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
